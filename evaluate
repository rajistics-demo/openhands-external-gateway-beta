#!/usr/bin/env bash
# ./evaluate — single entry point for this customer-evaluation Compose package.
#
# What this script does and does not do:
#   - Always includes docker-compose.security.yml (never deploys the base stack's
#     insecure placeholder defaults for DB_PASS/AUTOMATION_WEBHOOK_SECRET/
#     AUTOMATION_KV_SECRET/AUTOMATION_SERVICE_KEY, CORS origins pinned to
#     localhost, or an auto-generated/file-persisted JWT_SECRET).
#   - Generates JWT_SECRET, DB_PASS, AUTOMATION_WEBHOOK_SECRET,
#     AUTOMATION_KV_SECRET, and AUTOMATION_SERVICE_KEY locally with Python's
#     stdlib `secrets` module the first time it runs, atomically (O_CREAT|O_EXCL,
#     mode 600) so two concurrent runs can't race each other or silently overwrite
#     an existing file. If .env.generated-secrets already exists, it is reused
#     as-is and untouched. Generated values are written only to that local,
#     gitignored-by-convention file and are never printed to the terminal or logs.
#   - `./evaluate config` validates quietly: it runs `docker compose config
#     --quiet`, which parses and resolves every value (including your real
#     secrets) but prints nothing on success — only parse/validation errors, with
#     no resolved values of any kind. It does not dump the merged config to your
#     terminal or logs.
#   - Fails fast if COMPOSE_PROJECT_NAME is unset or empty in .env — this value
#     drives docker-compose.yml's SANDBOX_DOCKER_NETWORK, and an unset value
#     silently produces a nonexistent network name instead of an error from
#     Compose itself.
#   - Defaults to normal customer-external-LiteLLM mode: it does not start the
#     optional demo LiteLLM stack or seed any demo identities unless --demo is
#     passed explicitly.
#   - Contains no credentials, license values, or real resource IDs of its own.
#     .env (base) and .env.customer-gateway (your real gateway profile/relay
#     settings) are still yours to create from the .example files in this
#     directory — this script does not fill those in for you.
#
# Usage:
#   ./evaluate up [--demo]      Build nothing; bring the stack up (see below for build)
#   ./evaluate down             Stop the stack (keeps volumes)
#   ./evaluate down --volumes   Stop the stack and delete its volumes (destructive)
#   ./evaluate config [--demo]  Validate the fully-merged config; quiet on success,
#                               never prints resolved values (see above)
#   ./evaluate --help

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

SECRETS_FILE=".env.generated-secrets"
REQUIRED_ENV_FILES=(".env" ".env.customer-gateway")
COMPOSE_FILES=(-f docker-compose.yml -f docker-compose.customer-gateway.yml -f docker-compose.security.yml)
ENV_FILE_ARGS=()
DEMO=0

usage() {
    sed -n '2,34p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

generate_secrets_file() {
    echo "Ensuring $SECRETS_FILE exists (JWT_SECRET, DB_PASS, AUTOMATION_WEBHOOK_SECRET, AUTOMATION_KV_SECRET, AUTOMATION_SERVICE_KEY)..."
    python3 - "$SECRETS_FILE" <<'PY'
import os
import secrets
import sys

path = sys.argv[1]
names = (
    "JWT_SECRET",
    "DB_PASS",
    "AUTOMATION_WEBHOOK_SECRET",
    "AUTOMATION_KV_SECRET",
    "AUTOMATION_SERVICE_KEY",
)

# Atomic create-only open: if the file already exists, this raises FileExistsError
# and the existing file (and its secrets) is left completely untouched — no
# read-then-write race with a concurrent ./evaluate, and no accidental overwrite.
try:
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
except FileExistsError:
    print(f"{path} already exists; reusing it unchanged.")
    sys.exit(0)

with os.fdopen(fd, "w") as f:
    f.write("# Generated by ./evaluate — do not commit. Re-running ./evaluate reuses\n")
    f.write("# this file unchanged. Back it up with the database. Never regenerate\n")
    f.write("# JWT_SECRET after encrypted credentials exist; see docs/ROLLBACK.md.\n")
    for name in names:
        f.write(f"{name}={secrets.token_hex(32)}\n")
print(f"Done. Values were written to {path} only; they were not printed above.")
PY
}

check_required_env_vars() {
    if [[ ! -f .env ]]; then
        return  # caught by check_required_env_files below
    fi
    # Only the last matching assignment in the file is what Compose will actually
    # use, so read that one rather than just grep -q for the key's presence.
    local value
    value="$(grep -E '^COMPOSE_PROJECT_NAME=' .env | tail -n1 | cut -d= -f2-)"
    if [[ -z "$value" ]]; then
        echo "COMPOSE_PROJECT_NAME is unset or empty in .env." >&2
        echo "docker-compose.yml's SANDBOX_DOCKER_NETWORK is \${COMPOSE_PROJECT_NAME}_default;" >&2
        echo "an empty value silently resolves to a network Compose never creates, instead" >&2
        echo "of failing loudly. Set it explicitly in .env — see .env.example." >&2
        exit 1
    fi
}

check_required_env_files() {
    local missing=0
    for f in "${REQUIRED_ENV_FILES[@]}"; do
        if [[ ! -f "$f" ]]; then
            echo "Missing $f — copy ${f}.example to $f and fill in your real values first." >&2
            missing=1
        fi
    done
    if [[ "$missing" -ne 0 ]]; then
        echo "See docs/SETUP.md." >&2
        exit 1
    fi
    check_required_env_vars
}

build_env_file_args() {
    ENV_FILE_ARGS=(--env-file .env --env-file .env.customer-gateway --env-file "$SECRETS_FILE")
    if [[ "$DEMO" -eq 1 ]]; then
        if [[ ! -f .env.demo-litellm ]]; then
            echo "Missing .env.demo-litellm — copy .env.demo-litellm.example to .env.demo-litellm first." >&2
            exit 1
        fi
        ENV_FILE_ARGS+=(--env-file .env.demo-litellm)
        COMPOSE_FILES+=(-f docker-compose.demo-litellm.yml)
    fi
}

cmd="${1:-}"
shift || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --demo) DEMO=1 ;;
        --volumes) VOLUMES=1 ;;
        -h|--help) usage 0 ;;
        *) echo "Unknown flag: $1" >&2; usage 1 ;;
    esac
    shift
done

case "$cmd" in
    up)
        check_required_env_files
        generate_secrets_file
        build_env_file_args
        echo "Starting stack (security overlay always included; demo overlay: $([[ $DEMO -eq 1 ]] && echo on || echo off))..."
        docker compose "${ENV_FILE_ARGS[@]}" "${COMPOSE_FILES[@]}" up -d
        ;;
    down)
        check_required_env_files
        generate_secrets_file
        build_env_file_args
        if [[ "${VOLUMES:-0}" -eq 1 ]]; then
            echo "Stopping stack and deleting volumes (destructive)..."
            docker compose "${ENV_FILE_ARGS[@]}" "${COMPOSE_FILES[@]}" down --volumes
        else
            docker compose "${ENV_FILE_ARGS[@]}" "${COMPOSE_FILES[@]}" down
        fi
        ;;
    config)
        check_required_env_files
        generate_secrets_file
        build_env_file_args
        # --quiet parses and resolves every value but prints nothing on success —
        # this validates without ever echoing resolved secrets to the terminal/logs.
        docker compose "${ENV_FILE_ARGS[@]}" "${COMPOSE_FILES[@]}" config --quiet \
            && echo "Config OK (resolved values not printed; see --help)."
        ;;
    ""|-h|--help)
        usage 0
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage 1
        ;;
esac

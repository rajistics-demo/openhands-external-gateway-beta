# Only needed if you use the OPTIONAL docker-compose.demo-litellm.yml overlay instead
# of the customer's own LiteLLM. These are demo-fixture values, never read by the
# Enterprise app/worker.
DEMO_LITELLM_MASTER_KEY=sk-demo-local-master-key-change-me
DEMO_LITELLM_SALT_KEY=demo-local-salt-key-change-me
DEMO_LITELLM_HOST_PORT=4000
DEMO_LITELLM_IMAGE=ghcr.io/berriai/litellm:1.103.6

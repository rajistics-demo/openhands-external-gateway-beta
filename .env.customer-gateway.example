# Copy to .env.customer-gateway and fill in with the customer's real values.
# These are PLACEHOLDERS ONLY. No real origins, tokens or customer identifiers are
# included in this package.

# Both of these are APP origin paths, not the customer's gateway origin. The app
# itself relays chat/completions to whichever upstream the org's gateway profile names
# (`base_url` in the JSON passed to `cli set-org` — see cli/example-profile.json);
# server/customer_gateway/routes.py mounts that relay at /api/customer-gateway/v1 and
# the token re-mint at /api/customer-gateway/token (verified against this source tree;
# see docs/TOPOLOGY.md). Must resolve from inside sandbox containers (same reachability
# as webhooks).
CUSTOMER_GATEWAY_RELAY_URL=https://REPLACE-WITH-APP-ORIGIN/api/customer-gateway/v1
CUSTOMER_GATEWAY_TOKEN_URL=https://REPLACE-WITH-APP-ORIGIN/api/customer-gateway/token

CUSTOMER_GATEWAY_TOKEN_TTL_SECONDS=900

# Keep false outside isolated internal test networks. HTTPS is required for any
# customer-facing origin.
CUSTOMER_GATEWAY_ALLOW_HTTP_TEST_ONLY=false

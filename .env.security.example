# Copy to .env.security and fill with real, randomly generated secrets.
# Required by docker-compose.security.yml (recommended for every evaluation run, not
# just customer-facing ones). No defaults are provided here deliberately — the base
# compose file's own unauthenticated defaults ("openhands",
# "local-compose-webhook-secret", "local-compose-kv-secret") are not acceptable even
# for a controlled evaluation.
#
# Generate each with e.g.: openssl rand -hex 32

JWT_SECRET=REPLACE-WITH-A-RANDOM-SECRET
DB_PASS=REPLACE-WITH-A-RANDOM-SECRET
AUTOMATION_WEBHOOK_SECRET=REPLACE-WITH-A-RANDOM-SECRET
AUTOMATION_KV_SECRET=REPLACE-WITH-A-RANDOM-SECRET
# Must be the same single value on app/worker (as AUTOMATIONS_SERVICE_KEY) and
# automation-server (as AUTOMATION_SERVICE_KEY) — this file's one value is used for
# all three by docker-compose.security.yml.
AUTOMATION_SERVICE_KEY=REPLACE-WITH-A-RANDOM-SECRET

# NEVER delete this file (or just JWT_SECRET from it) to "get a fresh start" once
# you've stored any real customer gateway key or other encrypted credential through
# this app — JWT_SECRET is the encryption key for that data at rest
# (openhands/app_server/utils/encryption_key.py's operator-supplied path). Losing it
# makes existing encrypted rows permanently unreadable; it does not delete them or
# let you re-enter the same credentials over them. Back this file up before any
# planned rotation, and only ever replace JWT_SECRET as a deliberate, documented
# step (see docs/ROLLBACK.md) — not as a routine "if something looks stuck" reset.

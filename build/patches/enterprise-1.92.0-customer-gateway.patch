diff --git a/docker-compose.customer-gateway.yml b/docker-compose.customer-gateway.yml
new file mode 100644
index 0000000..0e02015
--- /dev/null
+++ b/docker-compose.customer-gateway.yml
@@ -0,0 +1,18 @@
+# Opt-in customer inference gateway (prototype). Layer on the base file only when wanted:
+#   docker compose -f docker-compose.yml -f docker-compose.customer-gateway.yml up -d
+# The customer's gateway (e.g. their LiteLLM) is external; this file runs no gateway, holds
+# no gateway master/admin key, and runs no init/discovery/budget job against it. Per-member
+# virtual keys are imported with: docker compose exec app python -m server.customer_gateway.cli
+x-customer-gateway: &customer-gateway
+  CUSTOMER_GATEWAY_ENABLED: 'true'
+  # Must be reachable from sandbox containers (the same host they use for webhooks).
+  CUSTOMER_GATEWAY_RELAY_URL: ${CUSTOMER_GATEWAY_RELAY_URL:?Set CUSTOMER_GATEWAY_RELAY_URL in .env}
+  CUSTOMER_GATEWAY_TOKEN_URL: ${CUSTOMER_GATEWAY_TOKEN_URL:?Set CUSTOMER_GATEWAY_TOKEN_URL in .env}
+  CUSTOMER_GATEWAY_TOKEN_TTL_SECONDS: ${CUSTOMER_GATEWAY_TOKEN_TTL_SECONDS:-900}
+  CUSTOMER_GATEWAY_ALLOW_HTTP_TEST_ONLY: ${CUSTOMER_GATEWAY_ALLOW_HTTP_TEST_ONLY:-false}
+
+services:
+  app:
+    environment: *customer-gateway
+  worker:
+    environment: *customer-gateway
